{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/guide", "destination": "/guide.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/api/admin/(.*)", "destination": "/api/admin/[...path]?path=$1" },
    { "source": "/api/money/(.*)", "destination": "/api/money/[...path]?path=$1" },
    { "source": "/api/pantry/(.*)", "destination": "/api/pantry/[...path]?path=$1" },
    { "source": "/api/shopping/(.*)", "destination": "/api/shopping/[...path]?path=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 5 * * *" }
  ]
}
